[tick]
name=TheTick
; mode selects the wire protocol. Valid values come from the driver registry:
; NONE, WIEGAND, CLOCKANDDATA, OSDP_PD, OSDP_CP. A name this build does not
; support is reported on the display and in the log rather than silently
; falling back to doing nothing.
mode=NONE
pin_vsense=4
vsense_factor=11.0
pin_reset=9
dos_id=7fffffff:31
; Status LED. Off by default: a pulsing light on a device hidden inside a
; card reader is a liability.
heartbeat=false

[wifi_hotspot]
enable=true
hidden=false
ssid=TheTick-config
psk=accessgranted
ip=192.168.4.1

[wifi_client]
ssid=
psk=

[mdns]
host=TheTick

[wiegand]
pin_d0=0
pin_d1=1
pulse_width=34
pulse_gap=1966

[clockanddata]
pin_clock=0
pin_data=1
pulse_width=300

[ota]
password=ExtraSpecialPassKey

[syslog]
server=
port=514
service=accesscontrol
priority=36
host=TheTick

; Leaving both of these empty runs the web interface with no password at all.
; That is the default so a device is always recoverable, but it means anyone
; who can reach it can read the log and replay credentials - the dashboard
; says so while they are unset.
[http]
username=
password=

[ble]
service=f498124f-2137-4615-9859-30eb4cecffb5
characteristic=beb5483e-36e1-4688-b7f5-ea07361baaaa
passkey=123456

[osdp]
pin_de=7
pin_re=10
pin_rx=20
pin_tx=21
; pin_term is omitted where no bus terminator is fitted.
baudrate=115200
terminator=false
address=101
; 32 hex characters, or empty for no secure channel.
scbk=
